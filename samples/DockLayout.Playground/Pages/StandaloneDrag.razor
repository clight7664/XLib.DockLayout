@page "/standalone"
@layout EmptyLayout

<PageTitle>XLib.DockLayout Standalone Drag</PageTitle>

<div style="width: 100vw; height: 100vh; display: flex; flex-direction: column;">
    <DockLayout Definition="Definition" Options="_options">
        <TopToolbarTemplate>
            <RiderWorkbenchHeader Theme="_options.Theme"
                                  EnableThemeSwitching="_options.EnableThemeSupport"
                                  OnThemeChanged="ChangeThemeAsync" />
        </TopToolbarTemplate>
        <StatusBarTemplate>
            <span>Ready</span>
            <span class="playground-spacer"></span>
            <span>Standalone Drag</span>
        </StatusBarTemplate>
        <EmptyPanelTemplate Context="panel">
            <div class="playground-empty">@panel.Title has no content.</div>
        </EmptyPanelTemplate>
        <EmptyEditorTemplate Context="view">
            <div class="playground-empty">Drop an EditorTab into @view.Id.</div>
        </EmptyEditorTemplate>
    </DockLayout>
</div>

@code {
    private DockLayoutOptions _options = new()
    {
        AutoSave = false,
        AutoRestore = false,
        PersistenceKey = "xlibDockLayout.playground.standalone",
        TabOverflowMode = TabOverflowMode.Scroll,
        TabDedupMode = TabDedupMode.ActivateExisting,
        EnableThemeSupport = true,
        Theme = DockThemeMode.Dark,
        EnableSplitterCollapse = true,
        ShowSplitterCollapseButtons = true
    };

    private Task ChangeThemeAsync(DockThemeMode theme)
    {
        _options = _options with { Theme = theme };
        return InvokeAsync(StateHasChanged);
    }

    private static DockLayoutDefinition Definition { get; } = new()
    {
        Panels = new DockPanelDefinition[]
        {
            new() { Id = "explorer", Region = DockRegionName.LeftDockUpper, ContentId = "explorer", Title = "Explorer", Icon = "▱", InitialRatio = .55 },
            new() { Id = "search", Region = DockRegionName.LeftDockLower, ContentId = "search", Title = "Search", Icon = "⌕", InitialRatio = .45 },
            new() { Id = "outline", Region = DockRegionName.RightDockUpper, ContentId = "outline", Title = "Outline", Icon = "☷" },
            new() { Id = "properties", Region = DockRegionName.RightDockLower, ContentId = "properties", Title = "Properties", Icon = "⚙" },
            new() { Id = "terminal", Region = DockRegionName.BottomLeftDock, ContentId = "terminal", Title = "Terminal", Icon = ">_" },
            new() { Id = "problems", Region = DockRegionName.BottomRightDock, ContentId = "problems", Title = "Problems", Icon = "!" },
            new() { Id = "relations", Region = DockRegionName.BottomRightDock, ContentId = "relations", Title = "Relations", Icon = "▦" }
        },
        EditorViews = new EditorViewDefinition[]
        {
            new()
            {
                Id = "view-main",
                Lifecycle = EditorViewLifecycle.Template,
                ActiveTabId = "tab-readme",
                Tabs = new EditorTabDefinition[]
                {
                    new()
                    {
                        Id = "tab-welcome",
                        ContentId = "welcome",
                        Title = "Welcome",
                        Icon = "◆",
                        Closable = false,
                        Pinned = true
                    },
                    new()
                    {
                        Id = "tab-readme",
                        ContentId = "text-editor",
                        Title = "README.md",
                        Icon = "M",
                        DedupParameter = "/README.md",
                        Parameters = new Dictionary<string, object?>
                        {
                            ["Path"] = "/README.md",
                            ["Text"] = "# XLib.DockLayout\n\nStandalone full-screen drag layout page."
                        }
                    },
                    new()
                    {
                        Id = "tab-controller",
                        ContentId = "text-editor",
                        Title = "DockLayoutController.cs",
                        Icon = "C#",
                        DedupParameter = "/src/XLib.DockLayout/DockLayoutController.cs",
                        Parameters = new Dictionary<string, object?>
                        {
                            ["Path"] = "/src/XLib.DockLayout/DockLayoutController.cs",
                            ["Text"] = "public sealed class DockLayoutController : IDockLayoutHandle { }"
                        }
                    }
                }
            }
        }
    };
}
